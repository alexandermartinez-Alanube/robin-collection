# --- Modo recomendado: Cloud Pub/Sub (sin URL pública, sin túneles) ---

# Project ID (no el número) del proyecto de Google Cloud con la Chat API habilitada
GCP_PROJECT_ID=

# Nombre corto de la suscripción pull que creaste (no el path completo)
PUBSUB_SUBSCRIPTION=robin-chat-events-sub

# Ruta al JSON de la cuenta de servicio que Robin usa para leer Pub/Sub
# y para responder en Chat (autenticación "como la app").
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Opcional: restringe qué espacios de Chat pueden usar a Robin.
# Formato: "spaces/AAAA1111,spaces/BBBB2222" (deja vacío para permitir cualquiera)
GCHAT_ALLOWED_SPACES=

# Tiempo máximo (ms) que se espera la respuesta de Robin antes de abortar
ROBIN_TIMEOUT_MS=60000

# --- Solo si usas el modo alternativo HTTP endpoint (server.js / npm run start:http) ---
# PORT=8080
# GCHAT_PROJECT_NUMBER=
